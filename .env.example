# Infiltr configuration — copy to .env and fill in. NEVER commit the real .env
# (.gitignore and .dockerignore already exclude it).

# ── Secrets (required for a hardened deploy) ───────────────────────────
# Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
# Must be >=32 chars; startup refuses weak/placeholder values when auth is on.
INFILTR_SECRET_KEY=
POSTGRES_PASSWORD=

# ── Datastores ─────────────────────────────────────────────────────────
# Dev default is SQLite. Prod: Postgres.
DATABASE_URL=postgresql+psycopg://infiltr:${POSTGRES_PASSWORD}@postgres:5432/infiltr
# Shared state for horizontal scale (multi-replica concurrency caps + rate limits).
# Leave unset for single-node (in-process fallback).
REDIS_URL=redis://redis:6379/0

# ── Auth / access ──────────────────────────────────────────────────────
INFILTR_AUTH=1                    # enforce login + API keys
INFILTR_OPEN_REGISTRATION=0       # only the bootstrap admin self-registers
INFILTR_DOCS=0                    # no public OpenAPI in prod
INFILTR_CORS=                     # explicit console origin(s), comma-sep; no wildcard

# ── Scope guard (what may be scanned) ──────────────────────────────────
INFILTR_ALLOWLIST=                # e.g. *.yourscope.com,10.0.0.0/8  (strongly recommended)
INFILTR_ALLOW_NO_ALLOWLIST=       # =1 to explicitly accept an open scanner (discouraged)
INFILTR_BLOCKLIST=                # hosts/CIDRs to always reject
INFILTR_BLOCK_PRIVATE=1           # SSRF guard: refuse private/internal IPs
INFILTR_LOCK_OPTIONS=1            # users can't inject arbitrary scan options

# ── Concurrency + rate limits ──────────────────────────────────────────
INFILTR_MAX_CONCURRENT=3          # per-user concurrent scans
INFILTR_GLOBAL_MAX_CONCURRENT=20  # server-wide concurrent scans
INFILTR_RATE_LIMIT=60             # authed requests per window
INFILTR_RATE_WINDOW=60            # seconds
INFILTR_AUTH_RATE_LIMIT=10        # login/register attempts per IP per window
INFILTR_AUTH_RATE_WINDOW=300      # seconds
INFILTR_SCAN_MAX_AGE=3600         # Redis slot-leak guard: stale reservations age out

# ── Quarry delegation API ──────────────────────────────────────────────
INFILTR_QUARRY_WORKERS=10         # module parallelism per delegated scan
INFILTR_QUARRY_SYNC_DEADLINE=120  # seconds a sync /v1/quarry/scan blocks before partial

# ── Observability ──────────────────────────────────────────────────────
INFILTR_METRICS=1                 # expose /metrics (Prometheus)
INFILTR_METRICS_TOKEN=            # optional: require this token to scrape /metrics
INFILTR_SCHEDULER=1               # background cron scans + delta alerts

# ── Networking ─────────────────────────────────────────────────────────
PORT=8000
